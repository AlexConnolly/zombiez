# Copy to .env (never committed) for `npm run host`.
# The address friends use: your DuckDNS name.
PUBLIC_HOST=yourname.duckdns.org
# Optional: keeps the DuckDNS name pointed at your home IP.
DUCKDNS_DOMAIN=yourname
DUCKDNS_TOKEN=paste-your-duckdns-token-here
# Change this to any long random string.
GAME_SECRET=change-me
